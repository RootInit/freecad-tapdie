<?xml version="1.0" encoding="UTF-8"?>
<package format="1" xmlns="https://wiki.freecad.org/Package_Metadata">
  <name>TapDie</name>
  <description>Thread any cylinder by selecting a circular profile.</description>
  <version>0.1.1</version>
  <date>2026-08-04</date>
  <maintainer email="root@init.cx">Alexander</maintainer>
  <license>LGPL-2.1-or-later</license>
  <!-- MUST be <workbench>, even though this addon adds no workbench of its
       own. FreeCAD 1.1 parses package.xml and only executes InitGui.py for
       content declared <workbench>. Under <other> the directory is still put
       on sys.path (so `from tapdie import command` works by hand in the
       console) but InitGui.py never runs, so the command never registers and
       nothing appears in the Part menu, silently, with no Report view
       message. Verified by launching an offscreen GUI against two otherwise
       identical probe addons: <other> SKIPPED, <workbench> RAN.
       Note also: a malformed package.xml disables the addon just as
       completely. The parse error goes to stdout only, never to the Report
       view, so it is invisible to anyone running FreeCAD from a desktop
       launcher. (An XML comment may not contain a doubled hyphen; one here
       cost a debugging cycle.) -->
  <content>
    <workbench>
      <name>TapDie</name>
      <description>Adds a Tap / Die command to the Part workbench.</description>
      <subdirectory>./</subdirectory>
      <icon>resources/icons/tapdie_cutter.svg</icon>
    </workbench>
  </content>
</package>
